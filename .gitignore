# Root .gitignore for ai-chatbot-pg

# Node.js (Frontend & Backend)
**/node_modules/
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*
**/.pnpm-debug.log*
backend/dist/
frontend/build/
frontend/dist/

# Python (AI Service)
**/__pycache__/
**/*.py[cod]
**/*$py.class
**/*.so
**/.Python
**/env/
**/venv/
**/ENV/
**/dist/
**/*.egg-info/
**/*.egg
**/.pytest_cache/

# Environment Variables
**/.env
**/.env.*
!**/.env.example

# OS Files
.DS_Store
.DS_Store?
**/._*
**/.Spotlight-V100
**/.Trashes
ehthumbs.db
Thumbs.db

# IDEs
.vscode/
.idea/
*.swp
*.swo

# Docker
docker-compose.override.yml
